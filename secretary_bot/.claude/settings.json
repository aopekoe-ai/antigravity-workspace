{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .brain/scripts/checkpoint.py --claude-precompact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python .brain/scripts/checkpoint.py --claude-postcompact"
          }
        ]
      }
    ]
  }
}
