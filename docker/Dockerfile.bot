FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        rpyc==6.0.1 \
        mt5linux-updated \
        pandas \
        requests \
        google-genai \
        pydantic

COPY . /app

CMD ["python3", "main.py"]
